# BehaviorTree application parameters (consumed by trainit_run_bt), generated by the
# TrainIt Setup Assistant. FULLY DATA-DRIVEN: the tree is a uniform sequence of
# <MoveWaypoint waypoint="X"/>; every degree of freedom of each move lives HERE.
/**:
  ros__parameters:
    planner_mode: "{{ g.planner_mode }}"
    process_path_backend: "{{ g.process_path_backend }}"
    group: "{{ g.group }}"
    base_frame: "{{ g.base_frame }}"
    tip_link: "{{ g.tip_link }}"
    gripper_action: "{{ g.gripper_action }}"
    process_controller: "{{ g.process_controller }}"
    bt_tree_id: "{{ g.bt_tree_id }}"
    enforce_validation: {{ g.enforce_validation | fmtnum }}
{% if g.gripper_actuation == 'joint_position' %}
    # End-effector actuation = joint_position (ADR-0010): CloseGripper/OpenGripper drive the
    # gripper joint to these targets via GripperCommand, and publish a latched Bool on
    # gripper_cmd_topic to fire the per-backend sim grasp adapter (Gazebo LinkAttacher /
    # Isaac SurfaceGripper) + the planning-scene attach.
    gripper_close_position: {{ g.gripper_close_position | fmtnum }}
    gripper_open_position: {{ g.gripper_open_position | fmtnum }}
    gripper_cmd_topic: "{{ g.gripper_cmd_topic }}"
{% endif %}

    task_parameters:
{% for key, vals in scene_params %}
      {{ key }}: {{ vals | fmtlist }}
{% endfor %}
{% if payload %}
      {{ payload[0] }}: {{ payload[1] | fmtlist }}
{% endif %}
{% for wp in waypoints %}

      {{ wp.name }}:
        type: {{ wp.type }}
{% if wp.is_tcp %}
{% if wp.position %}
        position:    {{ wp.position | fmtlist }}
{% endif %}
{% if wp.orientation %}
        orientation: {{ wp.orientation | fmtlist }}
{% endif %}
{% if not wp.position %}
        # pose written at RUN TIME by this waypoint's vision/relative binding
{% endif %}
{% elif wp.named %}
        named: "{{ wp.named }}"
{% elif wp.joints %}
        joints: {{ wp.joints | fmtlist }}
{% endif %}
{% if wp.motion %}
        motion: {{ wp.motion }}
{% endif %}
{% if wp.planner %}
        planner: {{ wp.planner }}
{% endif %}
{% if wp.speed is not none %}
        speed: {{ wp.speed }}
{% endif %}
{% if wp.aux %}
        aux: {{ wp.aux | fmtlist }}
        aux_is_center: {{ wp.aux_is_center | fmtnum }}
{% endif %}
{% endfor %}
