#!/usr/bin/env python3
# -----------------------------------------------------------------------------
{% set served = served is defined and served %}
{% if served %}
# SERVE the {{ robot_name }} application's EXPORTED tasks to the cell's PLC (the Robot Task Interface, ADR-0032).
# Generated by the TrainIt Setup Assistant.
#
# trainit_task_server runs ONE JOB per PLC request -- a job runs the exported task's job_<task> tree of
# bt_trees/{{ tree_filename }} -- and never ends by itself. It starts FAULTED / SERVER_STARTED: the PLC (or the fake
# PLC, a separate test tool: ros2 run trainit_motion_runtime trainit_fake_plc) acknowledges with a RESET. The PLC is the
# cell's ONE machine master; the RTI is ordinary control, NOT a safety function (ADR-0033).
#
#   ros2 launch {{ app_package }} bringup.launch.py mode:=mock
#   ros2 launch {{ app_package }} trainit_task_server.launch.py
{% else %}
# Run the {{ robot_name }} application as a BEHAVIOR TREE (primary path).
# Generated by the TrainIt Setup Assistant.
#
# The application is the BT XML (bt_trees/{{ tree_filename }}) + bt_params.yaml;
# the executable (trainit_run_bt) is application-agnostic (framework).
#
#   ros2 launch {{ app_package }} bringup.launch.py mode:=isaac
#   ros2 launch {{ app_package }} trainit_bt.launch.py planner_mode:=ompl
{% endif %}
{% if cell_namespace %}#
# THE APPLICATION RUNS IN THE ROBOT'S NAMESPACE ({{ cell_namespace }}) — ADR-0016. trainit_run_bt is a
# CLIENT of this robot's move_group: MoveGroupInterface resolves the move_group action and
# every planning-scene service against its OWN node namespace, so a root-level BT would
# wait for ever on an action nobody serves. The DETECTOR nodes below stay GLOBAL: they
# publish /perception/<name>/detections, which DetectObject reads by absolute name, and
# the detector that watches the bin is one detector however many arms reach into it.
{% endif %}{% set perception_nodes = detectors or grasp_providers or external_detectors %}
{% set ends = perception_nodes and not served %}
{% if ends %}#
# It ENDS WITH THE TREE: the perception nodes it starts beside the runner would keep the
# launch alive after trainit_run_bt exits, so the runner's exit shuts this launch down
# (end_with_tree:=true, the default). An app bringup.launch.py that includes it passes
# end_with_tree:=false: there the cell -- the perception with it -- stays up after the tree.
{% endif %}# -----------------------------------------------------------------------------
import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
{% if ends %}
from launch.actions import DeclareLaunchArgument, OpaqueFunction, RegisterEventHandler, Shutdown
from launch.event_handlers import OnProcessExit
{% else %}
from launch.actions import DeclareLaunchArgument, OpaqueFunction
{% endif %}
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node

from trainit_motion_runtime.trainit_moveit_config import (
    build_move_group_params, available_pipeline_names)

MOVEIT_CONFIG_PACKAGE = "{{ moveit_config_package }}"
ROBOT_NAME = "{{ robot_name }}"
{% if cell_namespace %}
NS = "{{ cell_namespace }}"                  # the robot slot (ADR-0016); see the note above
{% endif %}


def launch_setup(context, *args, **kwargs):
    use_sim = LaunchConfiguration("use_sim_time").perform(context).lower() in ("true", "1")
    params, _ = build_move_group_params(
        robot_name=ROBOT_NAME, moveit_config_package=MOVEIT_CONFIG_PACKAGE, use_isaac=use_sim{% if gazebo_supported %},
        backend=LaunchConfiguration("mode").perform(context){% endif %})

    pkg = get_package_share_directory("{{ app_package }}")
    bt_tree = LaunchConfiguration("bt_tree_file").perform(context)
    if not bt_tree:
        bt_tree = os.path.join(pkg, "bt_trees", "{{ tree_filename }}")
    bt_params = os.path.join(pkg, "config", "bt_params.yaml")
{% if program is defined and program %}
    # A Canonical Task Program: the application's own motion profiles{{ ' and paths' if (program_paths is defined and program_paths) else '' }}
    profiles = os.path.join(pkg, "config", "motion_profiles.yaml")
{% if program_paths is defined and program_paths %}
    paths = os.path.join(pkg, "config", "paths.yaml")
{% endif %}
{% else %}
    profiles = os.path.join(
        get_package_share_directory("trainit_motion_runtime"), "config", "bt", "trainit_profiles.yaml")
{% endif %}

{% if served %}
    tasks = os.path.join(pkg, "config", "tasks.yaml")   # the exported tasks + export_table_id (ADR-0032)
{% endif %}
    node_params = {
        "bt_tree_file": bt_tree,
{% if served %}
        "tasks_file": tasks,
{% endif %}
        "planner_mode": LaunchConfiguration("planner_mode"),
        "motion_profiles_file": profiles,
{% if program_paths is defined and program_paths %}
        "paths_file": paths,
{% endif %}
        "available_pipelines": available_pipeline_names(),
        "groot_monitor": LaunchConfiguration("groot_monitor"),
    }

{% if detectors or grasp_providers %}
    perception = os.path.join(pkg, "config", "perception.yaml")

{% endif %}
    {{ 'actions =' if ends else 'return' }} [
{% for d in detectors %}
        # One detector_node per entry of config/perception.yaml: it publishes the
        # perception contract; the tree's DetectObject consumes it.
        Node(
            package="trainit_perception",
            executable="detector_node",
            name="detector_{{ d }}",
            output="screen",
            parameters=[{"config_file": perception, "detector_name": "{{ d }}",
                         "use_sim_time": use_sim}],
        ),
{% endfor %}
{% for g in grasp_providers %}
{% set d = g.name %}
{% if g.node == "surface_grasp_node" %}
        # GRASP PROVIDER "{{ d }}" (vNext M4, tp.surface_grasp): fits the measured surfaces of
        # config/perception.yaml's entry and publishes grasp CANDIDATES on
        # /perception/{{ d }}/grasp_candidates (+ grasp_diagnostics, grasp_markers, detect);
        # the tree's DetectCandidates source="candidates" consumes them. GLOBAL like the detectors.
{% else %}
        # GRASP PROVIDER "{{ d }}" (vNext M4.5, {{ g.node }}): publishes the grasp CANDIDATES of
        # config/perception.yaml's entry on /perception/{{ d }}/grasp_candidates (+ grasp_diagnostics,
        # detect); the tree's DetectCandidates source="candidates" consumes them. GLOBAL like the detectors.
{% endif %}
        Node(
            package="trainit_perception",
            executable="{{ g.node }}",
            name="grasp_provider_{{ d }}",
            output="screen",
            parameters=[{"config_file": perception, "detector_name": "{{ d }}",
                         "use_sim_time": use_sim}],
        ),
{% endfor %}
{% for e in external_detectors %}
{% if e.produces_instances is defined and e.produces_instances %}
        # EXTERNAL SEGMENTER "{{ e.detector }}" (vNext M4.5): its own node publishes an INSTANCE IMAGE
        # on /perception/{{ e.detector }}/instances (+ instance_info), never detections; the grasp
        # provider whose segmentation is instance_topic with source "{{ e.detector }}" reads it.
        # Launched by name only: its package is NOT an <exec_depend> of this bundle (ADR-0003);
        # install it beside the bundle. See the comment in package.xml.
{% else %}
        # EXTERNAL-NODE detector "{{ e.detector }}" (D-015): this method is implemented by
        # this node, not by trainit_perception, and it publishes the SAME contract on
        # /perception/{{ e.detector }}/detections, so DetectObject consumes it without
        # knowing the difference. GLOBAL like the pure-python detectors above (ADR-0016):
        # the detector that watches the bin is one detector however many arms reach in.
        # Its package is NOT an <exec_depend> of this bundle (ADR-0003: a package name
        # rosdep cannot resolve would break `rosdep install` for the whole workspace);
        # install it beside the bundle. See the comment in package.xml.
{% endif %}
        Node(
            package="{{ e.package }}",
            executable="{{ e.executable }}",
            name="{{ e.node_name }}",
            output="screen",
{{ e.arguments_block }}
        ),
{% endfor %}
        Node(
            package="trainit_motion_runtime",
            executable="{{ 'trainit_task_server' if served else 'trainit_run_bt' }}",
{% if cell_namespace %}
            namespace=NS,
{% endif %}
            output="screen",
            parameters=[params, bt_params, node_params, {"use_sim_time": use_sim}],
{% if cell_namespace %}
            # /tf and /tf_static stay global: one tree for the whole cell (ADR-0016).
            remappings=[("/tf", "/tf"), ("/tf_static", "/tf_static")],
{% endif %}
        ),
    ]
{% if ends %}
    if LaunchConfiguration("end_with_tree").perform(context).lower() in ("true", "1"):
        # The launch ends when the tree ends: trainit_run_bt (the list's last action) exits, and
        # the perception nodes above would otherwise keep the launch running for ever.
        runner = actions[-1]
        actions.append(RegisterEventHandler(OnProcessExit(
            target_action=runner,
            on_exit=lambda event, _context: [Shutdown(
                reason=f"trainit_run_bt exited (return code {event.returncode}): the application "
                       "has ended, so its perception nodes stop with it")])))
    return actions
{% endif %}


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument("planner_mode", default_value="{{ default_planner_mode }}",
                              description="{{ tmr_planner_modes }}"),
        DeclareLaunchArgument("bt_tree_file", default_value="",
                              description="BT XML (default: {{ tree_filename }})"),
        DeclareLaunchArgument("groot_monitor", default_value="true",
                              description="Groot2 live monitor (needs libzmq)"),
        DeclareLaunchArgument("use_sim_time", default_value="true"),
{% if ends %}
        DeclareLaunchArgument("end_with_tree", default_value="true",
                              description="Shut this launch down (its perception nodes included) "
                                          "when trainit_run_bt exits; bringup.launch.py passes false"),
{% endif %}
{% if gazebo_supported %}
        DeclareLaunchArgument("mode", default_value="isaac",
                              description="backend for the robot_description hardware plugin "
                                          "(mock|isaac|gazebo|real); planning-only here"),
{% endif %}
        OpaqueFunction(function=launch_setup),
    ])
