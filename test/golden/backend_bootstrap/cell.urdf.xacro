<?xml version="1.0"?>
<!-- Top-level MoveIt URDF for cell (TrainIt Motion Runtime instance),
     generated by the TrainIt Setup Assistant. Composes the self-contained geometry
     (cell_description) with this package's ros2_control block. Robot name
     "cell" matches MoveItConfigsBuilder("cell",
     package_name="cell_trainit_config"). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cell">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_isaac" default="false" />

    <!-- Robot geometry + end effector (decoupled, self-contained description) -->
    <xacro:include filename="$(find cell_description)/urdf/x.urdf.xacro" />

    <!-- ros2_control: mock (RViz) or isaac (TopicBasedSystem bridge) -->
    <xacro:include filename="cell.ros2_control.xacro" />
    <xacro:cell_ros2_control
        name="CELLSystem"
        initial_positions_file="$(arg initial_positions_file)"
        use_isaac="$(arg use_isaac)"/>
</robot>
