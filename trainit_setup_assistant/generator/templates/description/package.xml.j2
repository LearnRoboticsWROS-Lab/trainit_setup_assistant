<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>{{ package_name }}</name>
  <version>{{ meta.version }}</version>
  <description>Self-contained {{ robot_name }} robot description (URDF/xacro + meshes),
    generated by the TrainIt Setup Assistant for the TrainIt Motion Runtime.</description>
  <maintainer email="{{ meta.maintainer_email }}">{{ meta.maintainer_name }}</maintainer>
  <license>{{ meta.license }}</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <!-- view_robot.launch.py: look at the robot alone, before any MoveIt/app wiring -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
