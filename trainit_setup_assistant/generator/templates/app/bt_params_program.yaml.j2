# BehaviorTree application parameters (consumed by trainit_run_bt), generated by the TrainIt Setup
# Assistant from a Canonical Task Program. task_parameters holds the WAYPOINTS: each entry is a
# target (WHERE) and the move that reaches it (motion, planner, profile, speed and accel in percent);
# the comment above an entry names the steps that use it and the PROVIDER TSA resolved for them; a
# ptp or free move's `planner` key is that provider's planner MODE (what MoveWaypoint reads: provider
# pilz_ptp -> planner pilz, ompl -> ompl), a lin or circ move has none (always Pilz LIN / CIRC). The
# paths are config/paths.yaml, the profiles config/motion_profiles.yaml, the tasks
# bt_trees/task_program.xml.
/**:
  ros__parameters:
    # every ptp and free move names its own planner: planner_mode is the free provider's
    planner_mode: "{{ g.planner_mode }}"
    # cartesian_waypoints iff a path runs on that provider (TSA derives it from the paths)
    process_path_backend: "{{ g.process_path_backend }}"
    group: "{{ g.group }}"
    base_frame: "{{ g.base_frame }}"
    tip_link: "{{ g.tip_link }}"
{% if g.process_controller == 'ros' %}
    # fixed for every task program (not authored): no legacy gripper action, MainTree, the runtime's
    # trajectory validation on; the ROS process controller, because the program has process events
    # on logical channels (each publishes <channel>/process_enabled or process_value, latched, in
    # this runner's namespace: the same contract in mock, Isaac and on the real cell)
{% else %}
    # fixed for every task program (not authored): no legacy gripper action, the mock process
    # controller (no process events yet), MainTree, and the runtime's trajectory validation on
{% endif %}
    gripper_action: "{{ g.gripper_action }}"
    process_controller: "{{ g.process_controller }}"
    bt_tree_id: "{{ g.bt_tree_id }}"
    enforce_validation: {{ g.enforce_validation | fmtnum }}
{% if g.gripper_actuation == 'joint_position' %}
    gripper_close_position: {{ g.gripper_close_position | fmtnum }}
    gripper_open_position: {{ g.gripper_open_position | fmtnum }}
{% if g.gripper_cmd_topic %}
    gripper_cmd_topic: "{{ g.gripper_cmd_topic }}"
{% endif %}
{% endif %}
{% if g.eef_block %}
    # The end-effector contract (ADR-0022): every actuator, grasp site and the verification
    # policy, resolved. trainit_run_bt and the device's adapter read this same block.
{{ g.eef_block }}
{% endif %}

    task_parameters:
{% for line in task_parameters %}
{{ line }}
{% endfor %}
