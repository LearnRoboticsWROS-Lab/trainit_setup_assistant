#!/usr/bin/env python3
# -----------------------------------------------------------------------------
# Run the {{ robot_name }} application as a BEHAVIOR TREE (primary path).
# Generated by the TrainIt Setup Assistant.
#
# The application is the BT XML (bt_trees/{{ tree_filename }}) + bt_params.yaml;
# the executable (trainit_run_bt) is application-agnostic (framework).
#
#   ros2 launch {{ app_package }} bringup.launch.py mode:=isaac
#   ros2 launch {{ app_package }} trainit_bt.launch.py planner_mode:=ompl
# -----------------------------------------------------------------------------
import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, OpaqueFunction
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node

from trainit_motion_runtime.trainit_moveit_config import (
    build_move_group_params, available_pipeline_names)

MOVEIT_CONFIG_PACKAGE = "{{ moveit_config_package }}"
ROBOT_NAME = "{{ robot_name }}"


def launch_setup(context, *args, **kwargs):
    use_sim = LaunchConfiguration("use_sim_time").perform(context).lower() in ("true", "1")
    params, _ = build_move_group_params(
        robot_name=ROBOT_NAME, moveit_config_package=MOVEIT_CONFIG_PACKAGE, use_isaac=use_sim)

    pkg = get_package_share_directory("{{ app_package }}")
    bt_tree = LaunchConfiguration("bt_tree_file").perform(context)
    if not bt_tree:
        bt_tree = os.path.join(pkg, "bt_trees", "{{ tree_filename }}")
    bt_params = os.path.join(pkg, "config", "bt_params.yaml")
    profiles = os.path.join(
        get_package_share_directory("trainit_motion_runtime"), "config", "bt", "trainit_profiles.yaml")

    node_params = {
        "bt_tree_file": bt_tree,
        "planner_mode": LaunchConfiguration("planner_mode"),
        "motion_profiles_file": profiles,
        "available_pipelines": available_pipeline_names(),
        "groot_monitor": LaunchConfiguration("groot_monitor"),
    }

{% if detectors %}
    perception = os.path.join(pkg, "config", "perception.yaml")

{% endif %}
    return [
{% for d in detectors %}
        # One detector_node per entry of config/perception.yaml: it publishes the
        # perception contract; the tree's DetectObject consumes it.
        Node(
            package="trainit_perception",
            executable="detector_node",
            name="detector_{{ d }}",
            output="screen",
            parameters=[{"config_file": perception, "detector_name": "{{ d }}",
                         "use_sim_time": use_sim}],
        ),
{% endfor %}
        Node(
            package="trainit_motion_runtime",
            executable="trainit_run_bt",
            output="screen",
            parameters=[params, bt_params, node_params, {"use_sim_time": use_sim}],
        ),
    ]


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument("planner_mode", default_value="{{ default_planner_mode }}",
                              description="pilz | ompl | ompl_chomp | stomp"),
        DeclareLaunchArgument("bt_tree_file", default_value="",
                              description="BT XML (default: {{ tree_filename }})"),
        DeclareLaunchArgument("groot_monitor", default_value="true",
                              description="Groot2 live monitor (needs libzmq)"),
        DeclareLaunchArgument("use_sim_time", default_value="true"),
        OpaqueFunction(function=launch_setup),
    ])
