<?xml version="1.0"?>
<!-- Top-level MoveIt URDF for {{ robot_name }} (TrainIt Motion Runtime instance),
     generated by the TrainIt Setup Assistant. Composes the self-contained geometry
     ({{ description_package }}) with this package's ros2_control block. Robot name
     "{{ robot_name }}" matches MoveItConfigsBuilder("{{ robot_name }}",
     package_name="{{ moveit_config_package }}"). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="{{ robot_name }}">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_isaac" default="false" />

    <!-- Robot geometry + end effector (decoupled, self-contained description) -->
    <xacro:include filename="$(find {{ description_package }})/urdf/{{ top_xacro }}" />

    <!-- ros2_control: mock (RViz) or isaac (TopicBasedSystem bridge) -->
    <xacro:include filename="{{ robot_name }}.ros2_control.xacro" />
    <xacro:{{ robot_name }}_ros2_control
        name="{{ ros2_control_name }}"
        initial_positions_file="$(arg initial_positions_file)"
        use_isaac="$(arg use_isaac)"/>
</robot>
