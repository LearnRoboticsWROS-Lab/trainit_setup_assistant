<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>{{ package_name }}</name>
  <version>{{ meta.version }}</version>
  <description>Robot-specific MoveIt configuration for the {{ robot_name }} instance of
    the TrainIt Motion Runtime, generated by the TrainIt Setup Assistant. Holds only
    robot-specific data (SRDF, kinematics, joint/cartesian limits, controllers); the
    generic planning pipelines are provided by trainit_motion_runtime at launch time.</description>
  <maintainer email="{{ meta.maintainer_email }}">{{ meta.maintainer_name }}</maintainer>
  <license>{{ meta.license }}</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- self-contained robot geometry -->
  <exec_depend>{{ description_package }}</exec_depend>
  <!-- generic planner pipelines (ompl/pilz/chomp) are pulled from the framework -->
  <exec_depend>trainit_motion_runtime</exec_depend>

  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_planners_chomp</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
