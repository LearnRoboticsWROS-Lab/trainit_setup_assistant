<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>{{ package_name }}</name>
  <version>{{ meta.version }}</version>
  <description>Standalone scene+planner MoveIt configuration for the {{ robot_name }}
    cell, generated by the TrainIt Setup Assistant. Embeds the hand-made base config
    (mock/isaac/real bring-up + SRDF waypoints) and adds the OMPL/Pilz/CHOMP planners
    (from trainit_motion_runtime) plus a scene loader that injects the cell obstacles
    from config/scene.yaml. Self-contained: independent of the base moveit_config.</description>
  <maintainer email="{{ meta.maintainer_email }}">{{ meta.maintainer_name }}</maintainer>
  <license>{{ meta.license }}</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- framework: planner pipelines + the scene loader node -->
  <exec_depend>trainit_motion_runtime</exec_depend>

  <!-- MoveIt + planners -->
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_planners_chomp</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- bring-up: controllers, state publisher, sim hardware, viewer -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- connector packages: cell geometry ($(find …) in the URDF) + vendor/sim bridges -->
{% for p in bridge_packages %}  <exec_depend>{{ p }}</exec_depend>
{% endfor %}

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
