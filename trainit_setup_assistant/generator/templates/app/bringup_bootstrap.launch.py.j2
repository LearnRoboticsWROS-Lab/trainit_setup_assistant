#!/usr/bin/env python3
{% set ns_kw = 'namespace=NS, ' if cell_namespace else '' %}
{% set ns_sp = ' namespace=NS,' if cell_namespace else '' %}
{% set tf_rm = ', remappings=tf_global' if cell_namespace else '' %}
{% set tf_pre = 'tf_global + ' if cell_namespace else '' %}
{% set ns_log = ' namespace={NS}' if cell_namespace else '' %}
# -----------------------------------------------------------------------------
# {{ robot_name }} bring-up for the TrainIt Motion Runtime (mock | isaac | real).
# Generated by the TrainIt Setup Assistant.
#
# move_group is configured by build_move_group_params(): robot-specific data from
# {{ moveit_config_package }} + the GENERIC planner pipelines (ompl/pilz/chomp)
# from the trainit_motion_runtime framework.
#
#   ros2 launch {{ app_package }} bringup.launch.py mode:={{ default_mode }}
{% if cell_namespace %}#
# ONE NAMESPACE PER ROBOT ({{ cell_namespace }}) — ADR-0016. This robot's robot_state_publisher,
# controller_manager, controllers, move_group and scene manager all live under it, so a
# second robot in the same cell cannot fight it for /robot_description or
# /controller_manager. /tf and /tf_static stay GLOBAL (tf2_ros declares them absolute, and
# a namespaced tf gives each robot its own private world), and so do the cameras and
# /perception/** — a camera serves a station, and one detector serves every arm at it.
{% endif %}# -----------------------------------------------------------------------------
import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import (DeclareLaunchArgument, IncludeLaunchDescription,
                            LogInfo, OpaqueFunction, RegisterEventHandler)
from launch.event_handlers import OnProcessExit
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node

from trainit_motion_runtime.trainit_moveit_config import build_move_group_params

MOVEIT_CONFIG_PACKAGE = "{{ moveit_config_package }}"
ROBOT_NAME = "{{ robot_name }}"
{% if cell_namespace %}
NS = "{{ cell_namespace }}"                  # the robot slot (ADR-0016); see the note above
{% endif %}
ARM_CONTROLLER = "{{ arm_controller }}"
VALID_MODES = {{ valid_modes_py }}
ARM_JS_REMAP_TO = {{ arm_js_remap_to_py }}
BRIDGES = {{ bridges_py }}
REAL_INCLUDE = {{ real_include_py }}
GRIPPER_MOCK_ACTION = {{ gripper_mock_action_py }}
{% if cell_namespace %}
# Camera-side helpers stay at the ROOT (ADR-0016): a camera serves a STATION, not a robot,
# so its node and its topics are the cell's, not this slot's. Every other bridge here is
# this robot's own plumbing (gripper server, joint-state merger) and follows the namespace.
CAMERA_BRIDGE_PACKAGES = ("depth_image_proc",)
{% endif %}


def launch_setup(context, *args, **kwargs):
    mode = LaunchConfiguration("mode").perform(context)
    use_rviz = LaunchConfiguration("rviz").perform(context).lower() in ("true", "1")
    if mode not in VALID_MODES:
        raise RuntimeError(f"Unknown mode '{mode}'. Valid: {', '.join(VALID_MODES)}")

    use_isaac = (mode == "isaac")
    use_sim_time = use_isaac{% if gazebo_supported %} or mode == "gazebo"{% endif +%}
    common = {"use_sim_time": use_sim_time}
{% if cell_namespace %}
    # tf and tf_static are declared absolute by tf2_ros, but say it anyway: it is the one
    # pair that must NOT follow the namespace, and a reader should not have to know tf2's
    # internals to see it. Every namespaced node below carries this remapping.
    tf_global = [("/tf", "/tf"), ("/tf_static", "/tf_static")]
{% endif %}

    params, mc = build_move_group_params(
        robot_name=ROBOT_NAME, moveit_config_package=MOVEIT_CONFIG_PACKAGE, use_isaac=use_isaac{% if gazebo_supported %}, backend=mode{% endif %}{% if start_tolerance is defined and start_tolerance is not none %},
        # the application's start-state tolerance (application.runtime.allowed_start_tolerance)
        trajectory_execution={"trajectory_execution.allowed_start_tolerance": {{ start_tolerance | fmtnum }}}{% endif %})

    moveit_share = get_package_share_directory(MOVEIT_CONFIG_PACKAGE)
    ros2_controllers_path = os.path.join(moveit_share, "config", "ros2_controllers.yaml")
    rviz_config_path = os.path.join(moveit_share, "config", "moveit.rviz")

    nodes = [
        LogInfo(msg=f"[{ROBOT_NAME} bringup] mode={mode}{{ ns_log }} use_sim_time={use_sim_time}"),
        Node(package="robot_state_publisher", executable="robot_state_publisher",
             {{ ns_kw }}output="screen", parameters=[mc.robot_description, common]{{ tf_rm }}),
{% if cell_namespace %}
        # publish_robot_description_semantic: without it move_group keeps the SRDF to
        # itself and {{ cell_namespace }}/robot_description_semantic is an empty topic, which any tool
        # reading the TOPIC (RViz below is fed by parameter) would see as no robot at all.
        Node(package="moveit_ros_move_group", executable="move_group",
             namespace=NS, output="screen",
             parameters=[params, common, {"publish_robot_description_semantic": True}],
             remappings=tf_global),
{% else %}
        Node(package="moveit_ros_move_group", executable="move_group",
             output="screen", parameters=[params, common]),
{% endif %}
    ]

    if mode in ("mock", "isaac"):
        rc_remap = [("/joint_states", ARM_JS_REMAP_TO)] if ARM_JS_REMAP_TO else []
        nodes.append(Node(
            package="controller_manager", executable="ros2_control_node",
            output="screen",{{ ns_sp }}
            parameters=[mc.robot_description, ros2_controllers_path, common],
            remappings={{ tf_pre }}rc_remap))

        controllers = ["joint_state_broadcaster", ARM_CONTROLLER]
        spawners = [
            Node(package="controller_manager", executable="spawner",
{% if cell_namespace %}
                 namespace=NS,
                 arguments=[c, "--controller-manager", f"{NS}/controller_manager",
                            "--controller-manager-timeout", "60"],
                 output="screen")
{% else %}
                 arguments=[c, "--controller-manager", "/controller_manager",
                            "--controller-manager-timeout", "60"],
                 output="screen")
{% endif %}
            for c in controllers
        ]
        nodes.append(spawners[0])
        for prev, nxt in zip(spawners, spawners[1:]):
            nodes.append(RegisterEventHandler(OnProcessExit(target_action=prev, on_exit=[nxt])))

        # mock gripper action server: only in mock, and only when no cell bridge serves
        # the gripper (empty BRIDGES = a fresh bootstrap). Lets CloseGripper succeed.
        if mode == "mock" and GRIPPER_MOCK_ACTION and not BRIDGES:
            nodes.append(Node(
                package="{{ app_package }}", executable="mock_gripper_action_server.py",
                output="screen",{{ ns_sp }} parameters=[{"action": GRIPPER_MOCK_ACTION}, common]))

        for b in BRIDGES:
            if mode in b.get("modes", ["mock", "isaac"]):
                node_kwargs = {}
                if b.get("name"):
                    node_kwargs["name"] = b["name"]
{% if cell_namespace %}
                if b["package"] not in CAMERA_BRIDGE_PACKAGES:
                    node_kwargs["namespace"] = NS
{% endif %}
                nodes.append(Node(
                    package=b["package"], executable=b["executable"], output="screen",
                    parameters=[dict(p) for p in b.get("parameters", [])] + [common],
                    remappings={{ tf_pre }}[tuple(r) for r in b.get("remappings", [])],
                    **node_kwargs))
{% if gazebo_supported %}
    elif mode == "gazebo":
        # Gazebo Classic (ADR-0008): the gazebo_ros2_control plugin in the URDF <gazebo>
        # tag OWNS /controller_manager inside gzserver -> spawners ONLY, never a standalone
        # ros2_control_node. One robot_state_publisher + move_group (above), one
        # robot_description (GazeboSystem via backend=mode), one controller_manager.
        world = LaunchConfiguration("world").perform(context)
        # gazebo_ros2_control drives the in-gzserver controller_manager from the sim update
        # loop, so the sim must be RUNNING for controllers to activate (a paused sim makes
        # every controller switch time out). Start unpaused; GazeboSystem holds the initial
        # joint positions until the controllers take over.
        gz_args = {"gui": LaunchConfiguration("gui").perform(context),
                   "pause": "false", "verbose": "true"}
        if world:
            gz_args["world"] = world
        nodes.append(IncludeLaunchDescription(
            PythonLaunchDescriptionSource(os.path.join(
                get_package_share_directory("gazebo_ros"), "launch", "gazebo.launch.py")),
            launch_arguments=gz_args.items()))
        nodes.append(Node(package="gazebo_ros", executable="spawn_entity.py", output="screen",
                          arguments=["-entity", ROBOT_NAME, "-topic", "robot_description"]))
        gz_controllers = ["joint_state_broadcaster", ARM_CONTROLLER]
{% if gazebo_gripper_controller %}
        gz_controllers.append("{{ gazebo_gripper_controller }}")
{% endif %}
        gz_spawners = [
            Node(package="controller_manager", executable="spawner",
                 arguments=[c, "--controller-manager", "/controller_manager",
                            "--controller-manager-timeout", "120"], output="screen")
            for c in gz_controllers]
{% if gazebo_cm_bootstrap %}
        # opt-in TRANSIENT standalone controller_manager: nudges the in-gzserver plugin's
        # controllers to 'configured' before the spawners run (a documented Gazebo init race
        # some cells, e.g. UR, need). Fed the same robot_description + controllers; it exits
        # once the plugin CM is up (deployment.gazebo_cm_bootstrap; default off = spawners-only).
        from launch.event_handlers import OnProcessStart
        gz_cm = Node(package="controller_manager", executable="ros2_control_node",
                     parameters=[mc.robot_description, ros2_controllers_path, common],
                     remappings=[("~/robot_description", "/robot_description")], output="screen")
        nodes.append(gz_cm)
        nodes.append(RegisterEventHandler(
            OnProcessStart(target_action=gz_cm, on_start=[gz_spawners[0]])))
{% else %}
        nodes.append(gz_spawners[0])
{% endif %}
        for prev, nxt in zip(gz_spawners, gz_spawners[1:]):
            nodes.append(RegisterEventHandler(OnProcessExit(target_action=prev, on_exit=[nxt])))
        for b in BRIDGES:
            if mode in b.get("modes", ["mock", "isaac"]):
                node_kwargs = {"name": b["name"]} if b.get("name") else {}
                nodes.append(Node(
                    package=b["package"], executable=b["executable"], output="screen",
                    parameters=[dict(p) for p in b.get("parameters", [])] + [common],
                    remappings=[tuple(r) for r in b.get("remappings", [])], **node_kwargs))
{% endif %}
    else:  # real
        if REAL_INCLUDE:
            nodes.append(LogInfo(msg=f"[{ROBOT_NAME} bringup] mode=real: launching hardware bridge"))
            nodes.append(IncludeLaunchDescription(
                PythonLaunchDescriptionSource(os.path.join(
                    get_package_share_directory(REAL_INCLUDE["package"]),
                    "launch", REAL_INCLUDE["launch_file"]))))

{% if servo %}
    # MoveIt Servo (ADR-0015): this cell streams at least one move (execution: servo),
    # so the out-of-process servo_node comes up WITH the cell and the tree's ServoTrack
    # finds its services. moveit_servo 2.5.10 on Humble is a NODE, not a library.
    #
    # All FOUR robot_description params are required, each for a reason paid for once:
    #   robot_description            : without it the node hangs ~20 s, then segfaults.
    #   robot_description_semantic   : the SRDF, for the planning group.
    #   robot_description_kinematics : the IK solver Servo's jacobian path needs.
    #   robot_description_planning   : the JOINT LIMITS. Without them a malformed
    #     <safety_controller> in a vendor URDF collapses every position bound to [0,0]
    #     and Servo emits NaN — planning hides it because move_group loads this file.
    nodes.append(Node(
        package="moveit_servo", executable="servo_node_main", name="servo_node",
        output="screen",{{ ns_sp }}
        parameters=[os.path.join(moveit_share, "config", "servo.yaml"),
                    mc.robot_description, mc.robot_description_semantic,
                    mc.robot_description_kinematics, mc.joint_limits, common]{{ tf_rm }}))

{% endif %}
    if use_rviz:
        # RViz's MotionPlanning display runs its OWN PlanningSceneMonitor. If it inherits
        # move_group's publish_planning_scene flags it starts PUBLISHING on
        # monitored_planning_scene (the very topic it also subscribes to) -> a self-sustaining
        # echo of stale FULL scenes that resurrects removed/attached objects (grasped bottles
        # reappear ~1s after grasp). Give RViz a params copy with those flags OFF so only
        # move_group publishes; RViz just subscribes.
        rviz_params = dict(params)
        for _k in ("publish_planning_scene", "publish_geometry_updates",
                   "publish_state_updates", "publish_transforms_updates"):
            rviz_params[_k] = False
{% if cell_namespace %}
        # RVIZ RUNS AT THE ROOT, and that is measured, not stylistic: MoveIt's
        # MotionPlanning plugin does not build the end-effector INTERACTIVE MARKER when
        # RViz itself is inside a namespace — its marker server is created at the root
        # whatever the node's namespace. So the CELL is namespaced and the VIEWER is not,
        # and the two description TOPICS are pointed at this robot by remapping (they
        # cannot be absolute in the .rviz config: "Robot Description" ends up inside a
        # NODE name, where a '/' is illegal). The move_group namespace and the scene and
        # trajectory topics are already written into this cell's moveit.rviz.
        nodes.append(Node(
            package="rviz2", executable="rviz2", output="log",
            arguments=["-d", rviz_config_path],
            parameters=[rviz_params, common],
            remappings=[("/robot_description", f"{NS}/robot_description"),
                        ("/robot_description_semantic",
                         f"{NS}/robot_description_semantic")]))
{% else %}
        nodes.append(Node(
            package="rviz2", executable="rviz2", output="log",
            arguments=["-d", rviz_config_path],
            parameters=[rviz_params, common]))
{% endif %}

    return nodes


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument("mode", default_value="{{ default_mode }}",
                              description="Backend: {{ modes_human }}"),
        DeclareLaunchArgument("rviz", default_value="true",
                              description="Launch RViz with the MoveIt plugin"),
{% if gazebo_supported %}
        DeclareLaunchArgument("world", default_value="{{ world_default }}",
                              description="Gazebo .world file (mode:=gazebo); empty=Gazebo's "
                                          "default empty world. Point it at the cell world."),
        DeclareLaunchArgument("gui", default_value="true",
                              description="Gazebo client GUI (mode:=gazebo); gui:=false = headless"),
{% endif %}
        OpaqueFunction(function=launch_setup),
    ])
