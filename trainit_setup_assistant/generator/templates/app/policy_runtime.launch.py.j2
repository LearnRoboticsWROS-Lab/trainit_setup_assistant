#!/usr/bin/env python3
# -----------------------------------------------------------------------------
# Start the learned-policy runtime(s) for {{ app_package }} (ADR-0005).
# Generated by the TrainIt Setup Assistant.
#
# Each node loads a policy card shipped in this package (policies/<name>/) and runs
# it in the configured mode. It speaks the ROS contract the BT's RunPolicy /
# CheckRobotState nodes consume; the deterministic runtime stays torch-free.
#
# Run it ALONGSIDE the BT (needs onnxruntime or torch in the ROS python env):
#   ros2 launch {{ app_package }} policy_runtime.launch.py
#   ros2 launch {{ app_package }} bringup.launch.py mode:=isaac    # in another shell
# -----------------------------------------------------------------------------
import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch_ros.actions import Node

PKG = "{{ app_package }}"


def generate_launch_description():
    share = get_package_share_directory(PKG)
    nodes = []
{% for p in policies %}
    # policy "{{ p.name }}" ({{ p.mode }})
    nodes.append(Node(
        package="trainit_policy_runtime",
        executable="policy_runtime_node",
        name="{{ p.node_name }}",
        output="screen",
        parameters=[{
            "policy_card": os.path.join(share, "policies", "{{ p.name }}", "policy_card.yaml"),
            "mode": "{{ p.mode }}",
        }],
    ))
{% endfor %}
    return LaunchDescription(nodes)
