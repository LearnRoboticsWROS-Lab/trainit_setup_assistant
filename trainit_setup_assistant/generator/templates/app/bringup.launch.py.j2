#!/usr/bin/env python3
# -----------------------------------------------------------------------------
# {{ robot_name }} APPLICATION bring-up — ONE command for the whole stack.
# Generated by the TrainIt Setup Assistant.
#
# Includes {{ moveit_config_package }}/launch/bringup.launch.py (the "engine bay":
# move_group + OMPL/Pilz/CHOMP + mock/isaac/real wiring + gripper bridges + the
# scene loader + RViz), then starts the BehaviorTree application on top
# (trainit_run_bt, TrainIt Motion Runtime).
#
#   ros2 launch {{ app_package }} bringup.launch.py mode:={{ default_mode }}
#   ros2 launch {{ app_package }} bringup.launch.py mode:=mock bt:=false   # cell only
# -----------------------------------------------------------------------------
import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import (DeclareLaunchArgument, IncludeLaunchDescription,
                            LogInfo, OpaqueFunction, TimerAction)
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration

MOVEIT_CONFIG_PACKAGE = "{{ moveit_config_package }}"
APP_PACKAGE = "{{ app_package }}"
ROBOT_NAME = "{{ robot_name }}"
VALID_MODES = {{ valid_modes_py }}


def launch_setup(context, *args, **kwargs):
    mode = LaunchConfiguration("mode").perform(context)
    rviz = LaunchConfiguration("rviz").perform(context)
    run_bt = LaunchConfiguration("bt").perform(context).lower() in ("true", "1")
    bt_delay = float(LaunchConfiguration("bt_delay").perform(context))
    if mode not in VALID_MODES:
        raise RuntimeError(f"Unknown mode '{mode}'. Valid: {', '.join(VALID_MODES)}")

    cfg_share = get_package_share_directory(MOVEIT_CONFIG_PACKAGE)
    app_share = get_package_share_directory(APP_PACKAGE)

    actions = [
        LogInfo(msg=f"[{ROBOT_NAME} app] mode={mode} cell={MOVEIT_CONFIG_PACKAGE} "
                    f"bt={'on (in %.0fs)' % bt_delay if run_bt else 'OFF (bt:=false)'}"),
        # the whole cell: move_group + planners + controllers/bridges + scene + RViz
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                os.path.join(cfg_share, "launch", "bringup.launch.py")),
            launch_arguments={"mode": mode, "rviz": rviz}.items()),
    ]
    if run_bt:
        # give move_group + the scene loader time to come up, then run the application
        actions.append(TimerAction(period=bt_delay, actions=[IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                os.path.join(app_share, "launch", "trainit_bt.launch.py")),
            launch_arguments={
                "planner_mode": LaunchConfiguration("planner_mode").perform(context),
                "use_sim_time": "true" if mode == "isaac" else "false",
            }.items())]))
    return actions


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument("mode", default_value="{{ default_mode }}",
                              description="Backend: {{ modes_human }}"),
        DeclareLaunchArgument("rviz", default_value="true",
                              description="Launch RViz with the MoveIt plugin"),
        DeclareLaunchArgument("bt", default_value="true",
                              description="Run the BehaviorTree application"),
        DeclareLaunchArgument("bt_delay", default_value="8.0",
                              description="Seconds to wait for the cell before the BT starts"),
        DeclareLaunchArgument("planner_mode", default_value="{{ default_planner_mode }}",
                              description="pilz | ompl | ompl_chomp"),
        OpaqueFunction(function=launch_setup),
    ])
