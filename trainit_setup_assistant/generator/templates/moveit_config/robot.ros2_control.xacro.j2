<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="{{ robot_name }}_ros2_control" params="name initial_positions_file use_isaac{% if gazebo_supported %} use_gazebo:=false{% endif %}">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <!-- isaac -> TopicBasedSystem bridge ; otherwise -> mock (RViz only). -->
        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_isaac}">
                    <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                    <param name="joint_commands_topic">/isaac_joint_commands</param>
                    <param name="joint_states_topic">/isaac_joint_states</param>
                </xacro:if>
                <xacro:unless value="${use_isaac}">
{% if gazebo_supported %}
                    <xacro:if value="${use_gazebo}">
                        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                    </xacro:if>
                    <xacro:unless value="${use_gazebo}">
                        <plugin>mock_components/GenericSystem</plugin>
                    </xacro:unless>
{% else %}
                    <plugin>mock_components/GenericSystem</plugin>
{% endif %}
                </xacro:unless>
            </hardware>
{% for j in joints %}
            <joint name="{{ j }}">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">${initial_positions['{{ j }}']}</param></state_interface>
                <state_interface name="velocity"/>
            </joint>
{% endfor %}
        </ros2_control>
{% if gazebo_supported %}
        <!-- Gazebo Classic: the gazebo_ros2_control plugin creates /controller_manager
             INSIDE gzserver (ADR-0008). Its <parameters> single-source the controllers the
             spawners load; the bring-up launches spawners only, no standalone node. -->
        <xacro:if value="${use_gazebo}">
            <gazebo>
                <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
                    <parameters>$(find {{ moveit_config_package }})/config/ros2_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>
{% endif %}
{% if gripper_command_joint %}

        <!-- NOTE: '{{ gripper_command_joint }}' is intentionally NOT in ros2_control.
             Its state is published by the gripper bridge and merged into /joint_states;
             the gripper is triggered via its action/services (mode-agnostic). -->
{% endif %}
    </xacro:macro>
</robot>
