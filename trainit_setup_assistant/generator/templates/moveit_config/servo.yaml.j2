# MoveIt Servo parameters for the cell's servo_node, generated by the TrainIt Setup
# Assistant. Emitted ONLY because at least one move chose `execution: servo` (ADR-0015
# Decision 4): an all-`plan` application emits this file not at all.
#
# Servo is an OUT-OF-PROCESS node (ADR-0015 Decision 5 — on Humble moveit_servo 2.5.10
# is a node, not a library) driven over ROS by the ServoTrack BT node. The parameters
# live under the `moveit_servo` prefix because that is the namespace
# ServoParameters::makeServoParameters() declares them in.
#
# ARBITRATION (ADR-0015): Servo's output goes to the SAME JointTrajectoryController that
# MoveIt execution feeds. That controller accepts this topic while an action goal is in
# flight and the two then fight over it — the goal aborts on a tolerance violation with
# no useful message. ONE OWNER PER CONTROLLER: ServoTrack pauses Servo before any
# trajectory execution on this group and unpauses after.
/**:
  ros__parameters:
    moveit_servo:
      ## Properties of incoming commands
      # speed_units: commands are m/s and rad/s (not joystick-normalised), so a
      # ServoTrack velocity means the same thing on every cell.
      command_in_type: speed_units
      scale:
        linear: 0.2       # max linear velocity [m/s]   (cartesian commands)
        rotational: 0.5   # max angular velocity [rad/s] (cartesian commands)
        joint: 0.3        # max joint velocity          (joint commands)

      ## Properties of outgoing commands
      publish_period: 0.01
      low_latency_mode: false
      command_out_type: trajectory_msgs/JointTrajectory
      # MANDATORY with JointTrajectoryController defaults: the controller's command
      # interface is position, so a velocity-only stream commands nothing.
      publish_joint_positions: true
      publish_joint_velocities: true
      publish_joint_accelerations: false

      ## Smoothing
      smoothing_filter_plugin_name: online_signal_smoothing::ButterworthFilterPlugin

      ## Planning scene — move_group OWNS it; Servo only subscribes, so the cell's one
      ## scene.yaml covers the planned path and the streamed path alike.
      is_primary_planning_scene_monitor: false
      monitored_planning_scene_topic: {{ monitored_planning_scene_topic }}

      ## MoveIt properties (from the cell model)
      move_group_name: {{ move_group_name }}
      planning_frame: {{ planning_frame }}
      ee_frame_name: {{ ee_frame_name }}
      # commands must be given in the frame of a robot link; the base is the stable one
      robot_link_command_frame: {{ robot_link_command_frame }}

      ## Topics (from the cell model)
      joint_topic: {{ joint_topic }}
      status_topic: ~/status
      # the SAME arm controller MoveIt execution feeds -> see ARBITRATION above
      command_out_topic: {{ command_out_topic }}
      cartesian_command_in_topic: ~/delta_twist_cmds
      joint_command_in_topic: ~/delta_joint_cmds

      ## Stopping behaviour
      incoming_command_timeout: 0.2
      num_outgoing_halt_msgs_to_publish: 4

      ## Singularities and joint limits
      lower_singularity_threshold: 17.0
      hard_stop_singularity_threshold: 30.0
      joint_limit_margin: 0.1

      ## Collision checking for the whole robot body
      check_collisions: true
      collision_check_rate: 10.0
      self_collision_proximity_threshold: 0.01
      scene_collision_proximity_threshold: 0.02
