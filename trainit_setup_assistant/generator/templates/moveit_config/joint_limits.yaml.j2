# joint_limits.yaml — generated by the TrainIt Setup Assistant.
# Overrides/augments the dynamics in the URDF. Scaling factors are <= 1.0.
default_velocity_scaling_factor: {{ jl.default_velocity_scaling_factor | fmtnum }}
default_acceleration_scaling_factor: {{ jl.default_acceleration_scaling_factor | fmtnum }}

joint_limits:
{% for joint, lim in jl.per_joint.items() %}
  {{ joint }}:
    has_velocity_limits: {{ lim.has_velocity_limits | fmtnum }}
    max_velocity: {{ lim.max_velocity | fmtnum }}
    has_acceleration_limits: {{ lim.has_acceleration_limits | fmtnum }}
    max_acceleration: {{ lim.max_acceleration | fmtnum }}
{% endfor %}
