<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>{{ package_name }}</name>
  <version>{{ meta.version }}</version>
  <description>{{ robot_name }} application instance of the TrainIt Motion Runtime
    ({{ app_type }}): launch files, scene + waypoints (bt_params.yaml) and the Behavior
    Tree. Generated by the TrainIt Setup Assistant. Uses trainit_motion_runtime and
    {{ moveit_config_package }}.</description>
  <maintainer email="{{ meta.maintainer_email }}">{{ meta.maintainer_name }}</maintainer>
  <license>{{ meta.license }}</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>trainit_motion_runtime</exec_depend>
{% if has_perception %}
  <exec_depend>trainit_perception</exec_depend>
{% endif %}
  <exec_depend>{{ moveit_config_package }}</exec_depend>
  <exec_depend>{{ description_package }}</exec_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
{% for pkg in bridge_packages %}
  <exec_depend>{{ pkg }}</exec_depend>
{% endfor %}

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
